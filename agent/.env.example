LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Model mode: inference (default, LiveKit Cloud) or byok (bring your own keys)
MODEL_MODE=inference

# Optional: override inference TTS voice (default Ashley)
# INFERENCE_TTS_VOICE=Ashley

# --- Required only when MODEL_MODE=byok ---
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# OPENAI_LLM_MODEL=gpt-4.1-mini
# CARTESIA_TTS_MODEL=sonic-3
# CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
