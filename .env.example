# Shared LiveKit Cloud credentials (copy into agent/.env.local and web/.env.local)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agent (agent/.env.local) ---
# MODEL_MODE=inference   # default: LiveKit Inference (no third-party keys)
# MODEL_MODE=byok        # bring your own OpenAI / Deepgram / Cartesia keys
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=

# --- Web (web/.env.local) ---
AGENT_NAME=echo-agent
# Optional sandbox token server for local experimentation:
# NEXT_PUBLIC_USE_SANDBOX=true
# NEXT_PUBLIC_SANDBOX_ID=
# NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=
# SANDBOX_ID=
